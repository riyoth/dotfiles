# Only set aliases and defaults if uv is present on the system
if command -v uv &> /dev/null; then
    if [ -f "$XDG_DATA_HOME/../bin/uv-codeartifact" ]; then
        source $XDG_DATA_HOME/../bin/uv-codeartifact
    fi
    export PRE_COMMIT_USE_UV=1
    alias python="uv run python"
    alias python3="uv run python"
    alias pip="uv pip"
else
    # Optional: Fallback for when uv is missing
    # echo "Notice: uv not found. Python aliases not set."
fi
